<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>dots</title>

    <style>
        html, body {
            margin: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        #space {
            width: 100%;
            height: 100%;
            position: relative;
        }

        .dot {
            width: 5px;
            height: 5px;
            background: black;
            border-radius: 50%;
            position: absolute;
            transform: translate(-50%, -50%);
        }
    </style>
</head>

<body>

    <div id="space"></div>

    <script>
        const space = document.getElementById("space");

        space.addEventListener("click", function(event) {
            const dot = document.createElement("div");

            dot.className = "dot";

            dot.style.left = event.clientX + "px";
            dot.style.top = event.clientY + "px";

            space.appendChild(dot);
        });
    </script>

</body>
</html>
